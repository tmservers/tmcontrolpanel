{
  "name": "maniatsx",
  "version": "0.1.0",
  "description": "Write Trackmania manialinks in TSX",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./maniascript": {
      "types": "./dist/maniascript/index.d.ts",
      "default": "./dist/maniascript/index.js"
    },
    "./bun-plugin": {
      "types": "./dist/compiler/bun-plugin.d.ts",
      "default": "./dist/compiler/bun-plugin.js"
    },
    "./esbuild-plugin": {
      "types": "./dist/compiler/esbuild-plugin.d.ts",
      "default": "./dist/compiler/esbuild-plugin.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "typescript6": "npm:typescript@6.0.3"
  }
}
